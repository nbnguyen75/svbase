				</Dialog.Description>
				<div class="demo-row">
					<Button class="demo-btn-outline">Extra action</Button>
					<Dialog.Close class="demo-btn-outline">Close</Dialog.Close>
				</div>
			</Dialog.Content>
		</Dialog.Portal>
	</Dialog.Root>
	<p class="demo-note">Tab cycles inside while open; Escape closes and returns focus here.</p>
