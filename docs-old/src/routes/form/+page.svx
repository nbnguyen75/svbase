<script lang="ts">
	import { Field, Fieldset, Form, Input } from 'svbase';

	import ApiTable, { type ApiProp } from '../ApiTable.svelte';
	import CodeBlock from '../CodeBlock.svelte';
	import Kbd from '../Kbd.svelte';

	let result = $state('—');
	let errorReport = $state('—');

	const anatomy = `<script>
  import { Field, Form } from 'svbase';
<\/script>

<Form.Form
  onFormSubmit={(values, errors) => {
    if (Object.keys(errors).length === 0) save(values);
  }}
>
  <Field.Root name="email">
    <Field.Label>Email</Field.Label>
    <Field.Control type="email" required />
    <Field.Description>We never share it.</Field.Description>
    <Field.Error />
  </Field.Root>
  <button type="submit">Save</button>
</Form.Form>`;

	const fieldProps: Array<ApiProp> = [
		{
			name: 'name',
			type: 'string',
			defaultValue: '—',
			description: 'Form field name. Falls back to the control’s own name.'
		},
		{
			name: 'disabled',
			type: 'boolean',
			defaultValue: 'false',
			description: 'Ignores interaction. Inherits fieldset disabled state.'
		},
		{
			name: 'invalid',
			type: 'boolean',
			defaultValue: '—',
			description: 'External invalid flag (e.g. server errors). Keeps the field invalid while set.'
		},
		{
			name: 'validate',
			type: '(value: unknown, formValues: Record<string, string>) => string | null',
			defaultValue: '—',
			description: 'Custom validator run after native constraints pass. Sync only.'
		},
		{
			name: 'validationMode',
			type: "'onBlur' | 'onChange' | 'onSubmit'",
			defaultValue: "'onBlur'",
			description: 'When validation runs. Overrides the enclosing Form’s mode.'
		}
	];

	const inputProps: Array<ApiProp> = [
		{
			name: 'value',
			type: 'string',
			defaultValue: "''",
			description: 'Current value (controlled).'
		},
		{
			name: 'name',
			type: 'string',
			defaultValue: '—',
			description: 'Form field name. Falls back to the enclosing Field’s name.'
		},
		{
			name: 'required',
			type: 'boolean',
			defaultValue: 'false',
			description: 'Native required constraint, validated by the enclosing Field.'
		},
		{
			name: 'onValueChange',
			type: '(value: string) => void',
			defaultValue: '—',
			description: 'Fired with the next value on every committed change.'
		}
	];

	const formProps: Array<ApiProp> = [
		{
			name: 'onFormSubmit',
			type: '(values: Record<string, string>, errors: Record<string, Array<string>>) => void',
			defaultValue: '—',
			description: 'Called on every submit with native values and per-field errors. Native submission is always prevented.'
		},
		{
			name: 'validationMode',
			type: "'onSubmit' | 'onBlur' | 'onChange'",
			defaultValue: "'onSubmit'",
			description: 'Default validation mode for nested fields. A field’s own mode wins.'
		}
	];
</script>

<p class="mb-2 text-xs tracking-[0.08em] text-muted-foreground uppercase">Svbase · Primitives</p>

# Form

Labelled fields with native constraint validation, custom validators, and a submit-collecting form wrapper.

<div class="mt-4 rounded-xl border bg-card p-6 text-card-foreground">
	<Form.Form
		onFormSubmit={(values, errors) => {
			result = JSON.stringify(values);
			errorReport = JSON.stringify(errors);
		}}
	>
		<Field.Root name="email">
			<Field.Label>Email</Field.Label>
			<Field.Control type="email" required placeholder="you@example.com" />
			<Field.Description>We never share it.</Field.Description>
			<Field.Error />
		</Field.Root>
		<Field.Root
			name="username"
			validate={(value) =>
				typeof value === 'string' && value.length < 3 ? 'At least 3 characters.' : null}
		>
			<Field.Label>Username</Field.Label>
			<Field.Control placeholder="ada" />
			<Field.Error />
		</Field.Root>
		<Fieldset.Root>
			<Fieldset.Legend>Notifications</Fieldset.Legend>
			<Field.Root name="newsletter">
				<Field.Label>Newsletter</Field.Label>
				<Input placeholder="Optional" />
			</Field.Root>
		</Fieldset.Root>
		<div class="flex flex-wrap items-center gap-3">
			<button
				type="submit"
				class="inline-flex h-9 items-center justify-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:brightness-110"
			>
				Save
			</button>
			<button
				type="reset"
				class="inline-flex h-9 items-center justify-center gap-2 rounded-md border bg-transparent px-4 py-2 text-sm font-medium transition-colors hover:bg-accent"
			>
				Reset
			</button>
		</div>
	</Form.Form>
	<p class="mt-3 text-sm text-muted-foreground">Values: <code class="rounded-md border bg-muted px-1.5 py-0.5 font-mono text-[0.8em]">{result}</code></p>
	<p class="mt-3 text-sm text-muted-foreground">Errors: <code class="rounded-md border bg-muted px-1.5 py-0.5 font-mono text-[0.8em]">{errorReport}</code></p>
</div>

## Anatomy

