			</div>
			<ContextMenu.Portal>
				<ContextMenu.Content class="min-w-48 rounded-lg border bg-popover p-1 shadow-md">
					<ContextMenu.Item
						class="rounded px-2 py-1.5 text-sm data-highlighted:bg-accent"
						onSelect={() => (picked = 'cut')}
					>
						Cut
					</ContextMenu.Item>
					<ContextMenu.Item
						class="rounded px-2 py-1.5 text-sm data-highlighted:bg-accent"
						onSelect={() => (picked = 'copy')}
					>
						Copy
					</ContextMenu.Item>
					<ContextMenu.Separator class="my-1 border-t" />
					<ContextMenu.SubRoot>
