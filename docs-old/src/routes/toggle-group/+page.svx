			description: 'Arrow-key axis.'
		},
		{
			name: 'name',
			type: 'string',
			defaultValue: '—',
			description: 'Form field name (one hidden input per selected value).'
		},
		{
			name: 'onValueChange',
			type: '(value: string | Array<string> | null) => void',
			defaultValue: '—',
			description: 'Fired with the next value on every toggle.'
		}
	];
</script>

<p class="mb-2 text-xs tracking-[0.08em] text-muted-foreground uppercase">Svbase · Primitives</p>

# Toggle Group

Single-select or multi-select toggle buttons with roving focus.

<div class="mt-4 rounded-xl border bg-card p-6 text-card-foreground">
	<ToggleGroup.Root bind:value={align} name="align">
		<div class="flex flex-wrap items-center gap-2">
			<ToggleGroup.Item value="left" class="rounded-md border px-3 py-1.5 text-sm data-pressed:bg-accent">Left</ToggleGroup.Item>
			<ToggleGroup.Item value="center" class="rounded-md border px-3 py-1.5 text-sm data-pressed:bg-accent">Center</ToggleGroup.Item>
			<ToggleGroup.Item value="right" disabled class="rounded-md border px-3 py-1.5 text-sm data-pressed:bg-accent">Right</ToggleGroup.Item>
		</div>
	</ToggleGroup.Root>
	<p class="mt-3 text-sm text-muted-foreground">Aligned: {align ?? '—'} (click again to clear)</p>
</div>

<div class="mt-4 rounded-xl border bg-card p-6 text-card-foreground">
	<h3>Multiple</h3>
	<ToggleGroup.Root bind:value={styles} multiple>
		<div class="flex flex-wrap items-center gap-2">
			<ToggleGroup.Item value="bold" class="rounded-md border px-3 py-1.5 text-sm data-pressed:bg-accent">Bold</ToggleGroup.Item>
			<ToggleGroup.Item value="italic" class="rounded-md border px-3 py-1.5 text-sm data-pressed:bg-accent">Italic</ToggleGroup.Item>
		</div>
	</ToggleGroup.Root>
	<p class="mt-3 text-sm text-muted-foreground">Styles: {styles.length ? styles.join(', ') : '—'}</p>
</div>

## Anatomy

<CodeBlock code={anatomy} filename="App.svelte" />

## API reference

### ToggleGroup.Root

<ApiTable props={rootProps} />

`ToggleGroup.Item` takes a unique `value` and renders a `Toggle` bound to the group — arrows travel with a single tab stop, and `data-pressed` marks the active items for styling.

## Keyboard interactions

- <Kbd>←</Kbd><Kbd>→</Kbd> move focus between items (vertical orientation: <Kbd>↑</Kbd><Kbd>↓</Kbd>); <Kbd>Home</Kbd> / <Kbd>End</Kbd> jump.
- <Kbd>Enter</Kbd> and <Kbd>Space</Kbd> flip the focused item.
