					<Dialog.Close class="inline-flex h-9 items-center justify-center gap-2 rounded-md border bg-transparent px-4 py-2 text-sm font-medium transition-colors hover:bg-accent">Close</Dialog.Close>
				</div>
			</Dialog.Content>
		</Dialog.Portal>
	</Dialog.Root>
	<p class="mt-3 text-sm text-muted-foreground">Tab cycles inside while open; Escape closes and returns focus here.</p>
