# Dialog

Modal dialog with focus trap, scroll lock, and Escape dismissal.

<div class="mt-4 rounded-xl border bg-card p-6 text-card-foreground">
	<Dialog.Root bind:open>
		<Dialog.Trigger class="inline-flex h-9 items-center justify-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:brightness-110">
			Open dialog (currently {open ? 'open' : 'closed'})
		</Dialog.Trigger>
		<Dialog.Portal>
			<Dialog.Overlay class="fixed inset-0 bg-black/50" />
			<Dialog.Content
				class="fixed top-1/2 left-1/2 w-full max-w-md -translate-x-1/2 -translate-y-1/2 rounded-lg border bg-card p-6 shadow-lg"
			>
				<Dialog.Title class="text-lg font-semibold">Confirm action</Dialog.Title>
