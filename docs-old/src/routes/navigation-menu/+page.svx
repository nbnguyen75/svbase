				<NavigationMenu.MenuItem
					class="rounded px-2 py-1.5 text-sm data-highlighted:bg-accent"
					onSelect={() => (picked = 'overview')}
				>
					Overview
				</NavigationMenu.MenuItem>
				<NavigationMenu.MenuItem
					class="rounded px-2 py-1.5 text-sm data-highlighted:bg-accent"
