				<p class="text-sm font-semibold">Ada Lovelace</p>
				<p class="mt-1 text-sm text-muted-foreground">First programmer. Hover away to dismiss.</p>
			</PreviewCard.Content>
		</PreviewCard.Portal>
	</PreviewCard.Root>
